{
  "name": "eliph",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "test:core": "jest --selectProjects core",
    "test:server": "jest --selectProjects server",
    "test:mcp": "jest --selectProjects mcp",
    "docs": "ts-node -T packages/server/src/docs-builder.ts",
    "docs:serve": "npm run docs && npx serve docs-site -l 4001",
    "start": "concurrently --names \"api,docs\" --prefix-colors \"cyan,magenta\" \"ts-node -T packages/server/src/index.ts\" \"npm run docs:serve\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
